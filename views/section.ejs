<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Gestion des Sections - APC Zighoud Youcef</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
 <link href="https://fonts.googleapis.com/css2?family=BBH+Sans+Bartle&family=Nunito:ital,wght@0,200..1000;1,200..1000&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
<style>
  
  * {
      font-family: "Nunito", sans-serif;
      font-optical-sizing: auto;
      font-style: normal;
    }
    /* 🌟 Général */
    body {
      font-family: 'Poppins', sans-serif;
      background: linear-gradient(135deg, #ffffff, #f3f4f6); /* Blanc */
      color: #1e293b;
      min-height: 100vh;
      transition: all 0.4s ease;
    }

    body.dark-mode {
      background: #1e293b;
      color: #f8fafc;
    }

    /* 🌟 Navbar tricolore */
    .navbar {
      background: linear-gradient(to right,#22c55e , #ffffff,#ef4444 ); /* Rouge-Blanc-Vert */
      border-radius: 12px;
      box-shadow: 0 6px 18px rgba(0,0,0,0.1);
      position: fixed;
      width: 100%;
      top: 0;
      z-index: 1000;
      padding: 0.5rem 1rem;
    }
  /* Appliquer l'animation au logo */
.navbar-brand img {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  animation: pulse 2s infinite;
  border: 2px solid #22c55e; /* gardé vert pour ton thème */
}
    /* Animation pulse pour le logo */
@keyframes pulse {
  0% {
    transform: scale(1);
    opacity: 1;
  }
  50% {
    transform: scale(1.1);
    opacity: 0.8;
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}
    .navbar-brand span {
      font-weight: 700;
      font-size: 1.2rem;
      color: #ef4444;
      margin-left: 0.5rem;
    }
    body.dark-mode .navbar-brand span { color: #22c55e; }

    .nav-link {
      font-weight: 500;
      color: #1e293b !important;
      transition: color 0.3s ease;
    }
    .nav-link:hover { color: #22c55e !important; }

    .btn-toggle {
      background: #22c55e;
      color: white;
      border-radius: 8px;
      transition: all 0.3s;
    }
    .btn-toggle:hover { transform: scale(1.05); }
    .logout {
      background: #ef4444;
      color: white;
      font-weight: 500;
      border-radius: 8px;
      transition: all 0.3s ease;
    }
    .logout:hover { transform: translateY(-2px); }

    /* 🌟 Conteneur */
    .container {
      padding-top: 120px;
      padding-bottom: 50px;
    }

    /* 🌟 Carte principale */
    .card-3d {
      background: rgba(255,255,255,0.85);
      backdrop-filter: blur(12px);
      border-radius: 16px;
      padding: 2rem;
      box-shadow: 0 8px 28px rgba(0,0,0,0.1);
      transition: all 0.3s ease;
    }
    .card-3d:hover { transform: translateY(-6px); }

    body.dark-mode .card-3d { background: rgba(30,41,59,0.85); }

    /* 🌟 Table */
    th {
      background: #ef4444; /* rouge */
      color: #ffffff;
      text-transform: uppercase;
      font-size: 0.85rem;
    }
    tr:hover { background: rgba(34,197,94,0.1); } /* vert léger */
    body.dark-mode th { background: #22c55e; color: #fff; }
    body.dark-mode tr:hover { background: rgba(239,68,68,0.1); } /* rouge clair hover */

    /* 🌟 Boutons */
    .btn-success { background:#22c55e ; border: none; }
    .btn-success:hover { background:#16a34a ; }
    .btn-danger { background:#ef4444 ; border: none; }
    .btn-danger:hover { background:#dc2626 ; }

    footer { text-align: center; margin-top: 2rem; color: #64748b; }
    body.dark-mode footer { color: #94a3b8; }
  </style>

<body>

  <!-- 🌟 Navbar -->
  <nav class="navbar navbar-expand-lg shadow-sm">
    <a class="navbar-brand d-flex align-items-center" href="#">
      <img src="/images/ZY.png" alt="Logo APC">
      <span style="color: gold;text-shadow:5px 5px 5px #1e293b;">APC ZIGHOUD Youcef</span>
    </a>
    

      
 <button class="nav-link">
      Bonjour <%=nom %><%='('+role+')' %>
    </button>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse justify-content-end" id="mainNav">
      <ul class="navbar-nav align-items-center gap-2">
        <li class="nav-item"><a class="nav-link" href="/materiel?nom=<%= nom %>&role=<%= role %>">🏠 Accueil</a></li>
        <li class="nav-item"><a class="nav-link" href="/section?nom=<%= nom %>&role=<%= role %>">📁 Sections</a></li>
        <% if(role==='Administrateur'){ %>
          <li class="nav-item"><a class="nav-link" href="/stock?nom=<%= nom %>&role=<%= role %>">📦 Stock</a></li>
        <% } %>
        <li class="nav-item"><button id="toggleMode" class="btn btn-sm btn-toggle">🌙</button></li>
        <li class="nav-item"><a href="/" class="logout btn btn-sm" style="background:#1e293b;">← Déconnexion</a></li>
      </ul>
    </div>
  </nav>

  <!-- 🌟 Contenu -->
 <body>

<!-- 🌟 Navbar -->
<nav class="navbar navbar-expand-lg shadow-sm">
  <a class="navbar-brand d-flex align-items-center" href="#">
    <img src="/images/ZY.png" alt="Logo APC">
    <span style="color: gold;text-shadow:5px 5px 5px #1e293b;">APC ZIGHOUD Youcef</span>
  </a>
           <p id="adm" style="margin: 5px;font-size:12px ;"> <%= nom %> (<%= role %>)</p>

  <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
    <span class="navbar-toggler-icon"></span>
  </button>

  <div class="collapse navbar-collapse justify-content-end" id="mainNav">
    <ul class="navbar-nav align-items-center gap-2">
      <li class="nav-item"><a class="nav-link" href="/materiel?nom=<%= nom %>&role=<%= role %>">🏠 Accueil</a></li>
    
        <li class="nav-item"><a class="nav-link" href="/section?nom=<%= nom %>&role=<%= role %>">📁 Sections</a></li>
        <li class="nav-item"><a class="nav-link" href="/stock?nom=<%= nom %>&role=<%= role %>">📦 Stock</a></li>
      

      <li class="nav-item">
        <button id="toggleMode" class="btn btn-sm btn-toggle">🌙</button>
      </li>

      <li class="nav-item">
        <a href="/" class="logout btn btn-sm" style="background:#1e293b;">← Déconnexion</a>
      </li>
    </ul>
  </div>
</nav>


<!-- 🌟 Page Container -->
<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-12 col-lg-10">

      <div class="card-3d mb-4">

        <!-- Formulaire -->
        <h5 class="mb-3 fw-semibold text-success">➕ Ajouter une Section</h5>
        <form id="addForm" class="row g-3" method="POST" action="/section/add?nom=<%= nom %>&role=<%= role %>">

          <div class="col-12 col-md-4">
            <input list="sectionsList" id="nomSectionInput" name="nom" class="form-control" placeholder="Nom de la section" required>
            <datalist id="sectionsList">
              <% sections.forEach(s => { %>
                <option value="<%= s.nom %>"></option>
              <% }) %>
            </datalist>
          </div>

          <div class="col-md-4 col-12">
            <input type="text" name="chef" class="form-control" placeholder="Chef de section" required>
          </div>

          <div class="col-md-4 col-12">
            <input type="text" name="localisation" class="form-control" placeholder="Localisation" required>
          </div>

          <div class="col-12 d-grid">
            <button class="btn btn-success fw-bold">Ajouter</button>
          </div>
        </form>


        <!-- Table -->
        <h3 class="mb-4 text-center fw-bold" style="color:#ef4444">🏷️ Gestion des Sections</h3>

       <div class="table-responsive overflow-auto">
  <table class="table table-hover text-center align-middle">
    <thead>
      <tr>
        <th>Nom</th>
        <th>Chef</th>
        <th>Localisation</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% sections.forEach(s => { %>
      <tr data-id="<%= s._id %>">
        <td contenteditable="true"><%= s.nom %></td>
        <td contenteditable="true"><%= s.chef %></td>
        <td contenteditable="true"><%= s.localisation %></td>
        <td class="d-flex gap-2 justify-content-center flex-wrap">
          <button class="btn btn-success btn-sm saveBtn">💾</button>
          <button class="btn btn-danger btn-sm deleteBtn">🗑</button>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>


        <hr class="my-4">
      </div>

      <footer class="text-center pt-3 pb-3">
        © 2025 — Gestion des Sections | APC Zighoud Youcef
      </footer>

    </div>
  </div>
</div>


  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  
  <!-- 🌙 Mode clair/sombre -->
  <script>
    const toggleBtn = document.getElementById('toggleMode');
    const body = document.body;
    if(localStorage.getItem('theme')==='dark'){
      body.classList.add('dark-mode');
      toggleBtn.textContent='☀️';
    }
    toggleBtn.addEventListener('click', ()=>{
      body.classList.toggle('dark-mode');
      const mode = body.classList.contains('dark-mode') ? 'dark':'light';
      localStorage.setItem('theme', mode);
      toggleBtn.textContent = mode==='dark' ? '☀️':'🌙';
    });

    // 🔄 Sauvegarde section
    document.querySelectorAll('.saveBtn').forEach(btn=>{
      btn.addEventListener('click', async e=>{
        const tr = e.target.closest('tr');
        const id = tr.dataset.id;
        const nom = tr.children[0].innerText.trim();
        const chef = tr.children[1].innerText.trim();
        const localisation = tr.children[2].innerText.trim();

        const res = await fetch(`/section/update/${id}`,{
          method:'PUT',
          headers:{'Content-Type':'application/json'},
          body: JSON.stringify({nom, chef, localisation})
        });
        if(res.ok) alert('✅ Section mise à jour !');
        else alert('❌ Erreur !');
      });
    });

    // 🗑 Suppression
    document.querySelectorAll('.deleteBtn').forEach(btn=>{
      btn.addEventListener('click', async e=>{
        if(!confirm('Supprimer cette section ?')) return;
        const tr = e.target.closest('tr');
        const id = tr.dataset.id;
        const res = await fetch(`/section/delete/${id}`, {method:'DELETE'});
        if(res.ok){ tr.remove(); alert('🗑️ Section supprimée !'); }
        else alert('❌ Erreur !');
      });
    });
  </script>
  <script>
  const nomInput = document.getElementById('nomSectionInput');
  const tbody = document.querySelector('tbody');

  nomInput.addEventListener('input', () => {
    const value = nomInput.value.trim();
    let exists = false;

    tbody.querySelectorAll('tr').forEach(tr => {
      const nomCell = tr.children[0].innerText.trim();
      if (nomCell.toLowerCase() === value.toLowerCase()) {
        exists = true;
      }
    });

    if (exists) {
      nomInput.style.borderColor = 'red';
      nomInput.style.color = 'red';
      nomInput.setCustomValidity('❌ Ce nom de section existe déjà !');
    } else {
      nomInput.style.borderColor = '';
      nomInput.style.color = '';
      nomInput.setCustomValidity('');
    }
  });
</script>

  
</body>
</html>
